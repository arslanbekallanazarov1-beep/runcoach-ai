OPENROUTER_API_KEY=your-openrouter-api-key
# Local async SQLite database. Cloud platforms may set this to a persistent
# SQLite path or a PostgreSQL URL (postgres:// and postgresql:// are supported).
DATABASE_URL=sqlite+aiosqlite:///./runcoach.db
# Optional; defaults to a lightweight Gemini Flash model.
LLM_MODEL=google/gemini-2.0-flash-001
# Used until user authentication is implemented.
LOCAL_USER_EMAIL=local-runner@runcoach.ai
